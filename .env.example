# Copy this file to .env (which is never committed) and fill in the values.
# Check them with:  python pipeline/check_keys.py

# FIRMS MAP_KEY: loads detections newer than the yearly archive (2026 onward).
# Request one (free, by e-mail) at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Google Earth Engine: weather, terrain, vegetation and population inputs of the danger
# model, the Landsat before/after pictures of a fire, and pipeline/event_enrich.py.
# EE_PROJECT is the id of a Google Cloud project registered for Earth Engine
# (https://code.earthengine.google.com/register).
EE_PROJECT=

# Sign-in, one of two ways:
#  1. Run `earthengine authenticate` once. It opens a browser and stores a token
#     in your user folder, outside this repository. Leave the next line empty.
#  2. Path to a service-account JSON key file kept outside this repository.
EE_SERVICE_ACCOUNT_KEY=
