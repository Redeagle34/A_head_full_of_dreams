# Copy this file to .env (which is never committed) and fill in the values.

# FIRMS MAP_KEY, needed later to load detections after the yearly archive ends.
# Request one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Google Cloud project registered for Earth Engine. Used for the Landsat before/after
# pictures of a fire and by pipeline/event_enrich.py. Sign in first with:
#   gcloud auth application-default login --scopes="https://www.googleapis.com/auth/earthengine,https://www.googleapis.com/auth/cloud-platform"
EE_PROJECT=
