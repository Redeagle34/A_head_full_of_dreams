# Upload only what the server needs: code, web/ and the small copy of the data.
# every hidden file and folder (.env, .git, .project, ...)
.*
*.env
proofs
__pycache__
requirements-pipeline.txt
/deploy
# pipeline/: only the script api/index.py reads the view of the observations from
pipeline/*
!pipeline/prepare_deploy.py
# data/: only data/deploy/, written by pipeline/prepare_deploy.py
data/*
!data/deploy
